{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${DORE_HOME:-$HOME/.dore-memory}\"; [ -x \"$h/.venv/bin/dore-hook\" ] || h=\"$HOME/Documents/dore\"; exec \"$h/.venv/bin/dore-hook\" prompt' 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=\"${DORE_HOME:-$HOME/.dore-memory}\"; [ -x \"$h/.venv/bin/dore-hook\" ] || h=\"$HOME/Documents/dore\"; exec \"$h/.venv/bin/dore-hook\" end' 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
