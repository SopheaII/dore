{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"${DORE_HOME:-$HOME/Documents/dore}/.venv/bin/dore-hook\" prompt' 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"${DORE_HOME:-$HOME/Documents/dore}/.venv/bin/dore-hook\" end' 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
